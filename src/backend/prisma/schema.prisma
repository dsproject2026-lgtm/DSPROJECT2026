generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

model Cargo {
  id        String    @id @default(uuid())
  nome      String    @db.VarChar(100)
  descricao String?
  eleicoes  Eleicao[]

  @@map("cargos")
}

model Faculdade {
  id           String       @id @default(uuid())
  nome         String       @unique @db.VarChar(150)
  cursos       Curso[]
  utilizadores Utilizador[]
  eleicoes     Eleicao[]

  @@map("faculdades")
}

model Curso {
  id           String       @id @default(uuid())
  faculdadeId  String       @map("faculdade_id")
  nome         String       @db.VarChar(150)
  faculdade    Faculdade    @relation(fields: [faculdadeId], references: [id])
  utilizadores Utilizador[]

  @@unique([faculdadeId, nome])
  @@map("cursos")
}

model Eleicao {
  id                    String         @id @default(uuid())
  cargoId               String         @map("cargo_id")
  faculdadeId           String?        @map("faculdade_id")
  titulo                String         @db.VarChar(200)
  descricao             String?
  estado                EstadoEleicao  @default(PROGRAMADA)
  escopoEleitores       EscopoEleitores @default(TODOS) @map("escopo_eleitores")
  dataInicioCandidatura DateTime?      @map("data_inicio_candidatura") @db.Timestamptz(6)
  dataFimCandidatura    DateTime?      @map("data_fim_candidatura") @db.Timestamptz(6)
  dataInicioVotacao     DateTime?      @map("data_inicio_votacao") @db.Timestamptz(6)
  dataFimVotacao        DateTime?      @map("data_fim_votacao") @db.Timestamptz(6)
  emDesempate           Boolean        @default(false) @map("em_desempate")
  candidatosDesempate   String[]       @default([]) @map("candidatos_desempate")
  numeroRodada          Int            @default(1) @map("numero_rodada")
  candidatos            Candidato[]
  comprovativos         Comprovativo[]
  elegiveis             Elegivel[]
  cargo                 Cargo          @relation(fields: [cargoId], references: [id])
  faculdade             Faculdade?     @relation(fields: [faculdadeId], references: [id])

  @@map("eleicoes")
}

model Utilizador {
  id                          String         @id @default(uuid())
  codigo                      String         @unique @db.VarChar(50)
  faculdadeId                 String?        @map("faculdade_id")
  cursoId                     String?        @map("curso_id")
  nome                        String         @db.VarChar(150)
  senhaHash                   String?        @map("senha_hash")
  perfil                      Perfil
  activo                      Boolean        @default(true)
  createdAt                   DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  email                       String?        @unique @db.VarChar(255)
  ano                         Int?
  mustSetPassword             Boolean        @default(false) @map("must_set_password")
  passwordSetupTokenHash      String?        @map("password_setup_token_hash")
  passwordSetupTokenExpiresAt DateTime?      @map("password_setup_token_expires_at") @db.Timestamptz(6)
  faculdade                   Faculdade?     @relation(fields: [faculdadeId], references: [id])
  curso                       Curso?         @relation(fields: [cursoId], references: [id])
  candidatosRegistados        Candidato[]    @relation("RegistadoPor")
  candidaturas                Candidato[]    @relation("CandidaturaDoUtilizador")
  comprovativos               Comprovativo[]
  elegiveis                   Elegivel[]
  logsAuditoria               LogAuditoria[]
  refreshTokens               RefreshToken[]
  team                         Team?

  @@map("utilizadores")
}

model RefreshToken {
  id                  String     @id @default(uuid())
  utilizadorId        String     @map("utilizador_id")
  tokenHash           String     @unique @map("token_hash")
  expiresAt           DateTime   @map("expires_at") @db.Timestamptz(6)
  revokedAt           DateTime?  @map("revoked_at") @db.Timestamptz(6)
  replacedByTokenHash String?    @map("replaced_by_token_hash")
  ip                  String?    @db.VarChar(45)
  userAgent           String?    @map("user_agent") @db.VarChar(255)
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  utilizador          Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@index([utilizadorId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Candidato {
  id           String          @id @default(uuid())
  eleicaoId    String          @map("eleicao_id")
  registadoPor String?         @map("registado_por")
  nome         String          @db.VarChar(150)
  fotoUrl      String?         @map("foto_url")
  biografia    String?
  proposta     String?
  estado       EstadoCandidato @default(APROVADO)
  utilizadorId String          @map("utilizador_id")
  eleicao      Eleicao         @relation(fields: [eleicaoId], references: [id])
  registador   Utilizador?     @relation("RegistadoPor", fields: [registadoPor], references: [id])
  utilizador   Utilizador      @relation("CandidaturaDoUtilizador", fields: [utilizadorId], references: [id])
  votos        Voto[]

  @@unique([eleicaoId, utilizadorId])
  @@map("candidatos")
}

model Elegivel {
  id           String     @id @default(uuid())
  eleicaoId    String     @map("eleicao_id")
  utilizadorId String     @map("utilizador_id")
  jaVotou      Boolean    @default(false) @map("ja_votou")
  importadoEm  DateTime   @default(now()) @map("importado_em") @db.Timestamptz(6)
  eleicao      Eleicao    @relation(fields: [eleicaoId], references: [id])
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id])

  @@unique([eleicaoId, utilizadorId])
  @@map("elegiveis")
}

model Voto {
  id           String    @id @default(uuid())
  candidatoId  String    @map("candidato_id")
  tokenAnonimo String    @unique @map("token_anonimo")
  dataHora     DateTime  @default(now()) @map("data_hora") @db.Timestamptz(6)
  numeroRodada Int       @default(1) @map("numero_rodada")
  candidato    Candidato @relation(fields: [candidatoId], references: [id])

  @@index([numeroRodada])
  @@map("votos")
}

model Comprovativo {
  id                String     @id @default(uuid())
  utilizadorId      String     @map("utilizador_id")
  eleicaoId         String     @map("eleicao_id")
  codigoVerificacao String     @unique @map("codigo_verificacao")
  emitidoEm         DateTime   @default(now()) @map("emitido_em") @db.Timestamptz(6)
  numeroRodada      Int        @default(1) @map("numero_rodada")
  eleicao           Eleicao    @relation(fields: [eleicaoId], references: [id])
  utilizador        Utilizador @relation(fields: [utilizadorId], references: [id])

  @@index([eleicaoId, numeroRodada])
  @@map("comprovativos")
}

model LogAuditoria {
  id           String      @id @default(uuid())
  utilizadorId String?     @map("utilizador_id")
  accao        String      @db.VarChar(100)
  entidade     String?     @db.VarChar(100)
  entidadeId   String?     @map("entidade_id") @db.Uuid
  ip           String?     @db.VarChar(45)
  timestamp    DateTime    @default(now()) @db.Timestamptz(6)
  utilizador   Utilizador? @relation(fields: [utilizadorId], references: [id])

  @@map("logs_auditoria")
}

model AppSetting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
}

model Team {
  id           String     @id @default(uuid())
  utilizadorId String     @unique @map("utilizador_id")
  nome         String     @db.VarChar(150)
  email        String     @unique @db.VarChar(255)
  perfil       Perfil
  codigo       String     @unique @db.VarChar(50)
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  utilizador   Utilizador @relation(fields: [utilizadorId], references: [id], onDelete: Cascade)

  @@map("team")
}

enum EstadoEleicao {
  PROGRAMADA
  ABERTA
  CONCLUIDA

  @@map("estado_eleicao")
}

enum EscopoEleitores {
  TODOS
  FACULDADE

  @@map("escopo_eleitores")
}

enum Perfil {
  ADMIN
  GESTOR_ELEITORAL
  AUDITOR
  ELEITOR
  CANDIDATO

  @@map("perfil")
}

enum EstadoCandidato {
  PENDENTE
  APROVADO
  REJEITADO
  SUSPENSO

  @@map("estado_candidato")
}
